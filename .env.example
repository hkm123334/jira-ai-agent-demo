# --- Gemini LLM API (Get a free key at https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Jira Cloud REST API ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# --- GitHub API (Needed for Phase 2 Auto-PR creation) ---
# In GitHub Actions, GITHUB_TOKEN and GITHUB_REPOSITORY are provided automatically.
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPOSITORY=your-username/your-repo-name
GITHUB_BASE_BRANCH=main

# --- Optional: Test Command run before opening PR (leave empty to skip) ---
# Examples: "pytest", "mvn test", "npm test"
TEST_COMMAND=

# --- Optional: Jira Project Key for Cron Polling ---
JIRA_PROJECT_KEY=PROJ
